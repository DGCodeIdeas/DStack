# DStack Cloud Deployment Configuration
# Copy this file to cloud/config.env and fill in your values
# All values are REQUIRED unless marked (optional)

# =============================================================================
# AWS Configuration
# =============================================================================
# AWS Region for deployment (free-tier eligible regions: us-east-1, us-west-2, eu-west-1, etc.)
AWS_REGION=us-east-1

# EC2 Instance Type (t3.small is free-tier eligible for 12 months, then ~$0.0208/hr)
# Free tier: t2.micro or t3.micro (750 hrs/month for 12 months)
# Recommended for production: t3.small (2 vCPU, 2GB RAM) - NOT free tier after 12 months
AWS_INSTANCE_TYPE=t3.small

# EC2 Key Pair name (must exist in the target AWS_REGION)
# Create via: aws ec2 create-key-pair --key-name YOUR_KEY --region $AWS_REGION
AWS_KEY_NAME=your-key-pair-name

# =============================================================================
# RDS Database Configuration (REQUIRED - DStack requires external RDS)
# =============================================================================
# RDS Endpoint (e.g., mydb.xxxxxxx.us-east-1.rds.amazonaws.com)
RDS_ENDPOINT=

# RDS Port (default 3306 for MySQL/MariaDB)
RDS_PORT=3306

# Database name to use/create
RDS_DB_NAME=dstack

# Database master username (set at RDS creation)
RDS_DB_USER=admin

# Database master password (set at RDS creation)
RDS_DB_PASSWORD=

# =============================================================================
# Application Configuration
# =============================================================================
# GitHub repository URL to clone (HTTPS or SSH)
# Example: https://github.com/yourusername/DStack.git
GITHUB_REPO_URL=https://github.com/yourusername/DStack.git

# Git branch to deploy (default: main)
GITHUB_BRANCH=main

# Domain name for Let's Encrypt SSL (optional but recommended for production)
# Example: dstack.example.com
DOMAIN=

# Email for Let's Encrypt registration and expiry notifications (required if DOMAIN set)
EMAIL_FOR_LETSENCRYPT=

# =============================================================================
# SSH / EC2 Configuration
# =============================================================================
# SSH username for the EC2 instance (ubuntu for Ubuntu AMIs, ec2-user for Amazon Linux)
SSH_USER=ubuntu

# Security Group name to create/use (will be created if not exists)
SECURITY_GROUP_NAME=dstack-sg

# Security Group description
SECURITY_GROUP_DESC="DStack security group - SSH, HTTP, HTTPS, MySQL"

# =============================================================================
# EC2 Instance Configuration
# =============================================================================
# EC2 Instance name tag
INSTANCE_NAME_TAG=devstack-prod

# AMI ID (Ubuntu 22.04 LTS in us-east-1 - update for other regions)
# Ubuntu 22.04 LTS (Jammy) AMD64: ami-0c02fb55956c7d316 (us-east-1)
# Find current: aws ssm get-parameter --name /aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id
AMI_ID=ami-0c02fb55956c7d316

# Root volume size in GB (minimum 8, recommended 20+ for Docker)
ROOT_VOLUME_SIZE=20

# =============================================================================
# Optional: RDS Security Group (if RDS is in a different SG)
# =============================================================================
# RDS Security Group ID (if RDS is in a different SG that needs EC2 SG access on 3306)
# RDS_SECURITY_GROUP_ID=sg-xxxxxxxxx

# =============================================================================
# Optional: SSH Bastion / Bastion Host (for RDS in private subnet)
# =============================================================================
# Bastion host public IP or DNS (if using SSH tunnel for RDS)
# BASTION_HOST=

# Bastion SSH user
# BASTION_USER=ubuntu

# =============================================================================
# Optional: GitHub Private Repository Access
# =============================================================================
# GitHub Personal Access Token (for private repos, use HTTPS URL with token)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# =============================================================================
# Optional: Additional Docker Compose Environment Variables
# =============================================================================
# Any additional env vars to inject into docker-compose.yml
# COMPOSE_EXTRA_ENV=