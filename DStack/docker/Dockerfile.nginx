# DevStack Nginx service
FROM nginx:alpine

# Remove the default nginx config and use our custom main config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy custom main nginx configuration (HTTP/2 + gzip enabled)
# Build context is  (see docker-compose.yml), so this path is relative to that
COPY nginx.conf /etc/nginx/nginx.conf

# Expose HTTP and HTTPS
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
