APP_NAME="DStack Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/panel.db

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

COMPOSE_PROJECT_NAME=devstack
PROJECTS_ROOT=/opt/dstack-panel/projects

# DStack paths
DSTACK_ROOT=/opt/dstack-panel
DSTACK_DOCKER_COMPOSE_FILE=${DSTACK_ROOT}/docker/docker-compose.yml
DSTACK_DOCKER_ENV_FILE=${DSTACK_ROOT}/.env
DSTACK_VHOSTS_DIR=${DSTACK_ROOT}/docker/vhosts
DSTACK_SSL_DIR=${DSTACK_ROOT}/docker/ssl
DSTACK_PROJECTS_DIR=${DSTACK_ROOT}/projects
DSTACK_BACKUPS_DIR=${DSTACK_ROOT}/backups

RDS_TUNNEL_ENABLED=false
RDS_ENDPOINT=
RDS_LOCAL_PORT=3307
RDS_SSH_USER=ubuntu
RDS_SSH_HOST=