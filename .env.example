# Compose project name (used as a prefix for containers, networks, volumes)
COMPOSE_PROJECT_NAME=devstack

# Database credentials
DB_ROOT_PASSWORD=changeme
DB_NAME=devstack
DB_USER=devstack
DB_PASSWORD=changeme

# Service ports
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
NGINX_PORT=80
REDIS_PORT=6379
APP_PORT=5000

# Environment
TZ=UTC

# PHP version (used by Dockerfile.php base image tag)
PHP_VERSION=8.2
