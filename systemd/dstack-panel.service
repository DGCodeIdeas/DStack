# ===== Legacy single-instance service (kept for manual fallback) =====
# The project now uses blue-green instances via dstack-panel@.service.
# This legacy file documents the original single-instance configuration.
[Unit]
Description=DStack Laravel Panel (legacy single-instance)
After=network.target docker.service

[Service]
User=www-data
WorkingDirectory=/opt/dstack-panel
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=5000
Restart=always
RestartSec=3
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
