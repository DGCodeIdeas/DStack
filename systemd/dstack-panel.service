# ===== Legacy single-instance service (replaced by dstack-panel@.service) =====
# This file is kept for reference only.
# The current architecture uses PHP-FPM + nginx instead of php artisan serve.
# Blue-green instances are managed via dstack-panel@.service template
# with nginx routing all requests to the active FPM pool.
[Unit]
Description=DStack Laravel Panel (legacy single-instance)
After=network.target php8.2-fpm.service nginx.service docker.service
Requires=php8.2-fpm.service nginx.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/dstack-panel
EnvironmentFile=-/opt/dstack-panel/.env.production
Environment=APP_ENV=production
ExecStart=/bin/bash -c '\
    cd /opt/dstack-panel && \
    php artisan cache:clear --no-warmup && \
    php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache && \
    /usr/bin/systemctl reload php8.2-fpm'
ExecStop=/usr/bin/systemctl reload php8.2-fpm
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
