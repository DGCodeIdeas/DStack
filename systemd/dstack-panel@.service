[Unit]
Description=DStack Laravel Panel (%i)
After=network.target docker.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/dstack-panel
EnvironmentFile=-/opt/dstack-panel/.env.%i
Environment=APP_ENV=production
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=${PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
